# Copia este archivo como ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a internet ni lo compartas.

# --- Cuenta que ENVÍA el correo ---
EMAIL_ADDRESS=tu_correo@gmail.com
# Para Gmail: es una "contraseña de aplicación" de 16 caracteres, NO tu contraseña normal.
# Para Outlook/Office365: también se recomienda una contraseña de aplicación.
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

# --- Servidor SMTP ---
# Gmail:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Outlook / Office365 (usar en vez de las de Gmail si corresponde):
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587

# Nombre que aparece como remitente en el correo enviado
EMAIL_DISPLAY_NAME=Informes de Instalación

# Clave secreta de Flask (podés dejar cualquier texto largo y aleatorio)
FLASK_SECRET_KEY=cambia-esto-por-un-texto-secreto-largo
